<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_LogisticsShipment"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.20.0">

  <bpmn:collaboration id="Collaboration_LogisticsShipment">
    <bpmn:participant id="Participant_Courier" name="Logistics and Shipment Exception Management Platform" processRef="Process_LogisticsShipment" />
  </bpmn:collaboration>

  <bpmn:process id="Process_LogisticsShipment" name="Shipment Lifecycle &amp; Exception Management" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_Logistics">
      <bpmn:lane id="Lane_Shipper" name="Shipper / Customer">
        <bpmn:flowNodeRef>StartEvent_BookingCreated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateShipmentBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorrectBookingAddress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UploadCustomsDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_BookingCancelledFee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ShipmentReturnedToSender</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_ControlTower" name="Control Tower / Dispatcher">
        <bpmn:flowNodeRef>Task_AssignPickupDriver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandlePickupException</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PickupAttempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyCustomerDelayETA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RerouteTransitVehicle</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Pickup" name="Pickup Agent">
        <bpmn:flowNodeRef>Task_CollectAndScanParcel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryError_PickupFailed</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Hub" name="Hub / Warehouse">
        <bpmn:flowNodeRef>Gateway_ParallelDispatchSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_HubLineHaulTransit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryMessage_ShipperCancellation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_TriggerCompensationCancellation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompensateHaltAndReturnParcel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelDispatchJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InspectDamagedParcel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InsuranceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManualScanSupervisorUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReconcileBarcodeData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DepotHold7Days</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Delivery" name="Delivery Agent">
        <bpmn:flowNodeRef>Task_DeliverParcelAndCapturePOD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DeliveryOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContactRecipientDoorstep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DoorstepAddressSurcharge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DeliveryAttempts</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Recipient" name="Recipient">
        <bpmn:flowNodeRef>Task_ReceiveParcelAndProvidePOD</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Claims" name="Claims Department">
        <bpmn:flowNodeRef>SubProcess_ClaimsSettlement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_TracingLostParcel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_LostParcelClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseShipmentGenerateInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ShipmentDelivered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- 1. Booking Creation & Validation (Happy Path + E2) -->
    <bpmn:startEvent id="StartEvent_BookingCreated" name="Shipper Books Shipment">
      <bpmn:outgoing>Flow_ToCreateBooking</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_CreateShipmentBooking" name="Create Shipment Booking" camunda:candidateGroups="shippers">
      <bpmn:incoming>Flow_ToCreateBooking</bpmn:incoming>
      <bpmn:incoming>Flow_ResubmitCorrectedAddress</bpmn:incoming>
      <bpmn:outgoing>Flow_ToValidateAddressAndTariff</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Business Rule Task: Validate Address, Weight & Calculate Tariff -->
    <bpmn:businessRuleTask id="Task_ValidateAddressAndTariff" name="Validate Address, Weight &amp; Calculate Tariff" camunda:resultVariable="tariffCalculation" camunda:decisionRef="decisionTariffCalculation" camunda:mapDecisionResult="singleResult">
      <bpmn:incoming>Flow_ToValidateAddressAndTariff</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAddressValidationGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gateway_AddressValidation" name="Address Valid?">
      <bpmn:incoming>Flow_ToAddressValidationGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_AddressValid</bpmn:outgoing>
      <bpmn:outgoing>Flow_AddressInvalidBooking</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_CorrectBookingAddress" name="Correct Incomplete Booking Address" camunda:candidateGroups="shippers">
      <bpmn:incoming>Flow_AddressInvalidBooking</bpmn:incoming>
      <bpmn:outgoing>Flow_ResubmitCorrectedAddress</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 2. Pickup Scheduling & Assignment -->
    <bpmn:serviceTask id="Task_AssignPickupDriver" name="Schedule Pickup &amp; Assign Driver" camunda:type="external" camunda:topic="assignPickupDriver">
      <bpmn:incoming>Flow_AddressValid</bpmn:incoming>
      <bpmn:incoming>Flow_ReschedulePickup</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPickupCollection</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 3. Pickup Execution (E1 Pickup Exceptions) -->
    <bpmn:userTask id="Task_CollectAndScanParcel" name="Collect Parcel &amp; Scan Barcode" camunda:candidateGroups="pickupAgents">
      <bpmn:incoming>Flow_ToPickupCollection</bpmn:incoming>
      <bpmn:outgoing>Flow_ToParallelSplit</bpmn:outgoing>
    </bpmn:userTask>

    <!-- E1: Error Boundary Event for Pickup Failure -->
    <bpmn:boundaryEvent id="BoundaryError_PickupFailed" name="Shipper Absent / Parcel Not Ready" attachedToRef="Task_CollectAndScanParcel">
      <bpmn:outgoing>Flow_ToPickupExceptionHandling</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDef_PickupFailed" errorRef="Error_PickupFailed" />
    </bpmn:boundaryEvent>

    <bpmn:userTask id="Task_HandlePickupException" name="Dispatcher Handles Pickup Exception" camunda:candidateGroups="dispatchers">
      <bpmn:incoming>Flow_ToPickupExceptionHandling</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPickupAttemptsGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_PickupAttempts" name="Pickup Attempts &lt;= 2?">
      <bpmn:incoming>Flow_ToPickupAttemptsGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ReschedulePickup</bpmn:outgoing>
      <bpmn:outgoing>Flow_CancelBookingPickupExceeded</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_BookingCancelledFee" name="Booking Cancelled (Fee Charged)">
      <bpmn:incoming>Flow_CancelBookingPickupExceeded</bpmn:incoming>
    </bpmn:endEvent>

    <!-- 4. Parallel Movement & Tracking Notification -->
    <bpmn:parallelGateway id="Gateway_ParallelDispatchSplit" name="Parallel Movement &amp; Tracking Update">
      <bpmn:incoming>Flow_ToParallelSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_ParallelToPhysicalTransit</bpmn:outgoing>
      <bpmn:outgoing>Flow_ParallelToTrackingNotification</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sendTask id="Task_SendShipperPickupNotice" name="Send Pickup Confirmation &amp; Tracking URL" camunda:type="external" camunda:topic="notifyShipperTracking">
      <bpmn:incoming>Flow_ParallelToTrackingNotification</bpmn:incoming>
      <bpmn:outgoing>Flow_TrackingNoticeToJoin</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- 5. Hub Transit Sub-Process (Multi-Instance Line-Haul, E3, E4, E5, E6, E9, E10) -->
    <bpmn:subProcess id="SubProcess_HubLineHaulTransit" name="Hub Sorting, Line-Haul Transit &amp; Customs Sub-Process">
      <bpmn:incoming>Flow_ParallelToPhysicalTransit</bpmn:incoming>
      <bpmn:outgoing>Flow_PhysicalTransitToJoin</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:loopCardinality xsi:type="bpmn:tFormalExpression">1</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>

      <bpmn:startEvent id="StartEvent_TransitLeg" name="Transit Leg Started">
        <bpmn:outgoing>Flow_SubTransit_ToHubScan</bpmn:outgoing>
      </bpmn:startEvent>

      <bpmn:serviceTask id="Task_HubInboundScan" name="Hub Inbound Scan &amp; Weight Verification" camunda:type="external" camunda:topic="hubInboundScan">
        <bpmn:incoming>Flow_SubTransit_ToHubScan</bpmn:incoming>
        <bpmn:incoming>Flow_SubTransit_ReconciledToTransit</bpmn:incoming>
        <bpmn:outgoing>Flow_SubTransit_ToCheckCustoms</bpmn:outgoing>
      </bpmn:serviceTask>

      <!-- E9: Scanner Failure Boundary Event -->
      <bpmn:boundaryEvent id="BoundaryError_ScannerFailure" name="Scanner Offline / Data Mismatch" attachedToRef="Task_HubInboundScan">
        <bpmn:outgoing>Flow_SubTransit_ToManualScanFix</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDef_ScanFailure" errorRef="Error_ScannerOffline" />
      </bpmn:boundaryEvent>

      <bpmn:userTask id="Task_ManualScanSupervisorUpdate" name="Hub Supervisor Updates Record Manually" camunda:candidateGroups="warehouseSupervisors">
        <bpmn:incoming>Flow_SubTransit_ToManualScanFix</bpmn:incoming>
        <bpmn:outgoing>Flow_SubTransit_ToReconciliation</bpmn:outgoing>
      </bpmn:userTask>

      <bpmn:serviceTask id="Task_ReconcileBarcodeData" name="Execute Barcode &amp; System Reconciliation" camunda:type="external" camunda:topic="reconcileBarcode">
        <bpmn:incoming>Flow_SubTransit_ToReconciliation</bpmn:incoming>
        <bpmn:outgoing>Flow_SubTransit_ReconciledToTransit</bpmn:outgoing>
      </bpmn:serviceTask>

      <!-- E6: Customs Check & Document Hold -->
      <bpmn:exclusiveGateway id="Gateway_CustomsRequired" name="International / Customs Required?">
        <bpmn:incoming>Flow_SubTransit_ToCheckCustoms</bpmn:incoming>
        <bpmn:outgoing>Flow_SubTransit_CustomsNeeded</bpmn:outgoing>
        <bpmn:outgoing>Flow_SubTransit_DomesticNoCustoms</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <bpmn:sendTask id="Task_RequestCustomsDocuments" name="Request Missing Customs Docs from Shipper" camunda:type="external" camunda:topic="requestCustomsDocs">
        <bpmn:incoming>Flow_SubTransit_CustomsNeeded</bpmn:incoming>
        <bpmn:outgoing>Flow_SubTransit_ToWaitForDocs</bpmn:outgoing>
      </bpmn:sendTask>

      <bpmn:userTask id="Task_UploadCustomsDocs" name="Shipper Uploads Required Export/Import Documents" camunda:candidateGroups="shippers">
        <bpmn:incoming>Flow_SubTransit_ToWaitForDocs</bpmn:incoming>
        <bpmn:outgoing>Flow_SubTransit_DocsProvided</bpmn:outgoing>
      </bpmn:userTask>

      <bpmn:boundaryEvent id="BoundaryTimer_CustomsHold5Days" name="5-Day Customs Timer" attachedToRef="Task_UploadCustomsDocs">
        <bpmn:outgoing>Flow_SubTransit_CustomsLapsedReturn</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDef_Customs5Days">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>

      <!-- E5: Transit Event-Based Gateway for Delay & Breakdown -->
      <bpmn:eventBasedGateway id="Gateway_TransitDelayOrTimer" name="Wait for Normal Arrival or Delay Event">
        <bpmn:incoming>Flow_SubTransit_DomesticNoCustoms</bpmn:incoming>
        <bpmn:incoming>Flow_SubTransit_DocsProvided</bpmn:incoming>
        <bpmn:outgoing>Flow_SubTransit_ToArrivalTimer</bpmn:outgoing>
        <bpmn:outgoing>Flow_SubTransit_ToDelayMessage</bpmn:outgoing>
        <bpmn:outgoing>Flow_SubTransit_To48hScanTimer</bpmn:outgoing>
      </bpmn:eventBasedGateway>

      <bpmn:intermediateCatchEvent id="Event_TransitArrivalTimer" name="Arrived Destination Hub on Schedule">
        <bpmn:incoming>Flow_SubTransit_ToArrivalTimer</bpmn:incoming>
        <bpmn:outgoing>Flow_SubTransit_ArrivedAtHub</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDef_ScheduledArrival">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT12H</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>

      <bpmn:intermediateCatchEvent id="Event_TransitDelayReceived" name="Delay Event Received (Weather / Breakdown)">
        <bpmn:incoming>Flow_SubTransit_ToDelayMessage</bpmn:incoming>
        <bpmn:outgoing>Flow_SubTransit_ToHandleDelay</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDef_TransitDelay" messageRef="Message_TransitDelay" />
      </bpmn:intermediateCatchEvent>

      <bpmn:serviceTask id="Task_NotifyCustomerDelayETA" name="Notify Customer &amp; Recalculate ETA" camunda:type="external" camunda:topic="notifyDelayETA">
        <bpmn:incoming>Flow_SubTransit_ToHandleDelay</bpmn:incoming>
        <bpmn:outgoing>Flow_SubTransit_ToRerouteVehicle</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:serviceTask id="Task_RerouteTransitVehicle" name="Reroute Vehicle / Dispatch Backup Fleet" camunda:type="external" camunda:topic="rerouteVehicle">
        <bpmn:incoming>Flow_SubTransit_ToRerouteVehicle</bpmn:incoming>
        <bpmn:outgoing>Flow_SubTransit_ArrivedAtHub</bpmn:outgoing>
      </bpmn:serviceTask>

      <!-- E4: 48-Hour Missing Scan Tracing Trigger -->
      <bpmn:intermediateCatchEvent id="Event_MissingScan48hTimer" name="48 Hours with No Barcode Scan">
        <bpmn:incoming>Flow_SubTransit_To48hScanTimer</bpmn:incoming>
        <bpmn:outgoing>Flow_SubTransit_ToTriggerTracingSubProcess</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDef_48hScan">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>

      <bpmn:endEvent id="EndEvent_TransitLegComplete" name="Transit Leg Finished">
        <bpmn:incoming>Flow_SubTransit_ArrivedAtHub</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>

    <!-- E10: Message Boundary Event for Shipper Cancellation in Transit -->
    <bpmn:boundaryEvent id="BoundaryMessage_ShipperCancellation" name="Shipper Cancels in Transit" attachedToRef="SubProcess_HubLineHaulTransit">
      <bpmn:outgoing>Flow_ToCompensationCancellation</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_ShipperCancellation" messageRef="Message_ShipperCancellation" />
    </bpmn:boundaryEvent>

    <bpmn:intermediateThrowEvent id="Event_TriggerCompensationCancellation" name="Trigger Transit Compensation">
      <bpmn:incoming>Flow_ToCompensationCancellation</bpmn:incoming>
      <bpmn:outgoing>Flow_CompensationToReturnSender</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompensateEventDef_Transit" activityRef="SubProcess_HubLineHaulTransit" />
    </bpmn:intermediateThrowEvent>

    <bpmn:serviceTask id="Task_CompensateHaltAndReturnParcel" name="Halt Transit, Issue Refund Minus Fee &amp; Route to Origin" isForCompensation="true" camunda:type="external" camunda:topic="compensateCancellation" />

    <!-- Join Parallel Gateway -->
    <bpmn:parallelGateway id="Gateway_ParallelDispatchJoin" name="Join Movement &amp; Updates">
      <bpmn:incoming>Flow_PhysicalTransitToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_TrackingNoticeToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinToOutForDeliveryNotification</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- 6. Out for Delivery & Last-Mile Handling (E2, E3, E7, E8) -->
    <bpmn:sendTask id="Task_NotifyRecipientOutForDelivery" name="Notify Recipient: Parcel Out for Delivery" camunda:type="external" camunda:topic="notifyOutForDelivery">
      <bpmn:incoming>Flow_JoinToOutForDeliveryNotification</bpmn:incoming>
      <bpmn:incoming>Flow_DeliveryAttemptRetry</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDeliveryHandover</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:userTask id="Task_DeliverParcelAndCapturePOD" name="Attempt Delivery &amp; Capture POD / COD" camunda:candidateGroups="deliveryAgents">
      <bpmn:incoming>Flow_ToDeliveryHandover</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDeliveryOutcomeGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ReceiveParcelAndProvidePOD" name="Receive Parcel, Sign POD / Pay COD" camunda:candidateGroups="recipients">
      <bpmn:incoming>Flow_DeliveryAttemptSuccessful</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCloseShipment</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_DeliveryOutcome" name="Delivery Outcome">
      <bpmn:incoming>Flow_ToDeliveryOutcomeGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_DeliveryAttemptSuccessful</bpmn:outgoing>
      <bpmn:outgoing>Flow_RecipientUnavailableE7</bpmn:outgoing>
      <bpmn:outgoing>Flow_RefusalOrCODFailureE8</bpmn:outgoing>
      <bpmn:outgoing>Flow_DamagedParcelE3</bpmn:outgoing>
      <bpmn:outgoing>Flow_WrongAddressDoorstepE2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- E2: Doorstep Address Resolution & Surcharge -->
    <bpmn:userTask id="Task_ContactRecipientDoorstep" name="Delivery Agent Contacts Recipient for Address Update" camunda:candidateGroups="deliveryAgents">
      <bpmn:incoming>Flow_WrongAddressDoorstepE2</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDoorstepSurchargeGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_DoorstepAddressSurcharge" name="Reroute Surcharge Required?">
      <bpmn:incoming>Flow_ToDoorstepSurchargeGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_SurchargeAddedAndRetry</bpmn:outgoing>
      <bpmn:outgoing>Flow_AddressUnresolvableReturn</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- E7: Recipient Unavailable Delivery Loop (Max 3 Attempts) -->
    <bpmn:exclusiveGateway id="Gateway_DeliveryAttempts" name="Delivery Attempts &lt; 3?">
      <bpmn:incoming>Flow_RecipientUnavailableE7</bpmn:incoming>
      <bpmn:incoming>Flow_SurchargeAddedAndRetry</bpmn:incoming>
      <bpmn:outgoing>Flow_DeliveryAttemptRetry</bpmn:outgoing>
      <bpmn:outgoing>Flow_MaxDeliveryAttemptsExceeded</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_DepotHold7Days" name="Hold at Local Depot for 7 Days" camunda:candidateGroups="warehouseSupervisors">
      <bpmn:incoming>Flow_MaxDeliveryAttemptsExceeded</bpmn:incoming>
      <bpmn:outgoing>Flow_DepotHoldExpiredReturnToSender</bpmn:outgoing>
    </bpmn:userTask>

    <!-- E3: Damaged Parcel Inspection & Claims Sub-Process -->
    <bpmn:userTask id="Task_InspectDamagedParcel" name="Inspect &amp; Document Parcel Damage" camunda:candidateGroups="warehouseSupervisors">
      <bpmn:incoming>Flow_DamagedParcelE3</bpmn:incoming>
      <bpmn:outgoing>Flow_ToInsuranceCheckGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_InsuranceCheck" name="Parcel Insured?">
      <bpmn:incoming>Flow_ToInsuranceCheckGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_InsuredClaimsSubProcess</bpmn:outgoing>
      <bpmn:outgoing>Flow_UninsuredNotifyShipper</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Claims Settlement Sub-Process -->
    <bpmn:subProcess id="SubProcess_ClaimsSettlement" name="Insurance Claims &amp; Reshipment Settlement Sub-Process">
      <bpmn:incoming>Flow_InsuredClaimsSubProcess</bpmn:incoming>
      <bpmn:outgoing>Flow_ClaimsResolvedToRTS</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_Claim" name="Claim Initiated">
        <bpmn:outgoing>Flow_SubClaim_ToAssess</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="Task_AssessClaimValuation" name="Claims Officer Assesses Valuation" camunda:candidateGroups="claimsOfficers">
        <bpmn:incoming>Flow_SubClaim_ToAssess</bpmn:incoming>
        <bpmn:outgoing>Flow_SubClaim_ToPay</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="Task_DisburseCompensationOrReship" name="Process Payout / Re-order Replacement" camunda:type="external" camunda:topic="disburseCompensation">
        <bpmn:incoming>Flow_SubClaim_ToPay</bpmn:incoming>
        <bpmn:outgoing>Flow_SubClaim_ToEnd</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent_ClaimSettled" name="Claim Resolved">
        <bpmn:incoming>Flow_SubClaim_ToEnd</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>

    <!-- E4: Tracing & Lost Parcel Sub-Process -->
    <bpmn:subProcess id="SubProcess_TracingLostParcel" name="5-Day Missing Parcel Tracing Sub-Process">
      <bpmn:incoming>Flow_SubTransit_ToTriggerTracingSubProcess</bpmn:incoming>
      <bpmn:outgoing>Flow_LostParcelSubProcessComplete</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_Tracing" name="Tracing Started">
        <bpmn:outgoing>Flow_SubTrace_ToInvestigation</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="Task_InvestigateDepotCCTV" name="Depot Security Investigates CCTV &amp; Scanning Logs" camunda:candidateGroups="warehouseSupervisors">
        <bpmn:incoming>Flow_SubTrace_ToInvestigation</bpmn:incoming>
        <bpmn:outgoing>Flow_SubTrace_To5DayTimer</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateCatchEvent id="Event_Tracing5DayTimer" name="5 Days Tracing Concluded">
        <bpmn:incoming>Flow_SubTrace_To5DayTimer</bpmn:incoming>
        <bpmn:outgoing>Flow_SubTrace_ToLostDetermination</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDef_Tracing5Days">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="Task_DeclareLostAndCompensate" name="Declare Parcel Lost &amp; Disburse Compensation" camunda:type="external" camunda:topic="declareLostCompensation">
        <bpmn:incoming>Flow_SubTrace_ToLostDetermination</bpmn:incoming>
        <bpmn:outgoing>Flow_SubTrace_ToEnd</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent_TracingLost" name="Tracing Completed as Lost">
        <bpmn:incoming>Flow_SubTrace_ToEnd</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>

    <bpmn:endEvent id="EndEvent_LostParcelClosed" name="Shipment Closed as Lost (Customer Compensated)">
      <bpmn:incoming>Flow_LostParcelSubProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Return to Sender End Event -->
    <bpmn:endEvent id="EndEvent_ShipmentReturnedToSender" name="Shipment Returned to Sender (RTS)">
      <bpmn:incoming>Flow_RefusalOrCODFailureE8</bpmn:incoming>
      <bpmn:incoming>Flow_DepotHoldExpiredReturnToSender</bpmn:incoming>
      <bpmn:incoming>Flow_SubTransit_CustomsLapsedReturn</bpmn:incoming>
      <bpmn:incoming>Flow_CompensationToReturnSender</bpmn:incoming>
      <bpmn:incoming>Flow_AddressUnresolvableReturn</bpmn:incoming>
      <bpmn:incoming>Flow_UninsuredNotifyShipper</bpmn:incoming>
      <bpmn:incoming>Flow_ClaimsResolvedToRTS</bpmn:incoming>
    </bpmn:endEvent>

    <!-- 7. Successful Delivery Closure & Invoicing -->
    <bpmn:serviceTask id="Task_CloseShipmentGenerateInvoice" name="Close Shipment &amp; Generate Final Invoice" camunda:type="external" camunda:topic="generateInvoice">
      <bpmn:incoming>Flow_ToCloseShipment</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDeliveredEndEvent</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_ShipmentDelivered" name="Shipment Successfully Delivered &amp; Closed">
      <bpmn:incoming>Flow_ToDeliveredEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- SEQUENCE FLOWS -->
    <bpmn:sequenceFlow id="Flow_ToCreateBooking" sourceRef="StartEvent_BookingCreated" targetRef="Task_CreateShipmentBooking" />
    <bpmn:sequenceFlow id="Flow_ToValidateAddressAndTariff" sourceRef="Task_CreateShipmentBooking" targetRef="Task_ValidateAddressAndTariff" />
    <bpmn:sequenceFlow id="Flow_ToAddressValidationGateway" sourceRef="Task_ValidateAddressAndTariff" targetRef="Gateway_AddressValidation" />
    <bpmn:sequenceFlow id="Flow_AddressValid" name="Valid Address" sourceRef="Gateway_AddressValidation" targetRef="Task_AssignPickupDriver">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isAddressValid == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AddressInvalidBooking" name="Incomplete Address (E2)" sourceRef="Gateway_AddressValidation" targetRef="Task_CorrectBookingAddress">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isAddressValid == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ResubmitCorrectedAddress" sourceRef="Task_CorrectBookingAddress" targetRef="Task_CreateShipmentBooking" />

    <bpmn:sequenceFlow id="Flow_ToPickupCollection" sourceRef="Task_AssignPickupDriver" targetRef="Task_CollectAndScanParcel" />
    <bpmn:sequenceFlow id="Flow_ToParallelSplit" sourceRef="Task_CollectAndScanParcel" targetRef="Gateway_ParallelDispatchSplit" />

    <!-- E1 Flows -->
    <bpmn:sequenceFlow id="Flow_ToPickupExceptionHandling" sourceRef="BoundaryError_PickupFailed" targetRef="Task_HandlePickupException" />
    <bpmn:sequenceFlow id="Flow_ToPickupAttemptsGateway" sourceRef="Task_HandlePickupException" targetRef="Gateway_PickupAttempts" />
    <bpmn:sequenceFlow id="Flow_ReschedulePickup" name="Attempts &lt;= 2" sourceRef="Gateway_PickupAttempts" targetRef="Task_AssignPickupDriver">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pickupAttempts &lt;= 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CancelBookingPickupExceeded" name="Attempts &gt; 2 (E1)" sourceRef="Gateway_PickupAttempts" targetRef="EndEvent_BookingCancelledFee">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pickupAttempts &gt; 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Parallel Branch Flows -->
    <bpmn:sequenceFlow id="Flow_ParallelToPhysicalTransit" sourceRef="Gateway_ParallelDispatchSplit" targetRef="SubProcess_HubLineHaulTransit" />
    <bpmn:sequenceFlow id="Flow_ParallelToTrackingNotification" sourceRef="Gateway_ParallelDispatchSplit" targetRef="Task_SendShipperPickupNotice" />
    <bpmn:sequenceFlow id="Flow_PhysicalTransitToJoin" sourceRef="SubProcess_HubLineHaulTransit" targetRef="Gateway_ParallelDispatchJoin" />
    <bpmn:sequenceFlow id="Flow_TrackingNoticeToJoin" sourceRef="Task_SendShipperPickupNotice" targetRef="Gateway_ParallelDispatchJoin" />
    <bpmn:sequenceFlow id="Flow_JoinToOutForDeliveryNotification" sourceRef="Gateway_ParallelDispatchJoin" targetRef="Task_NotifyRecipientOutForDelivery" />

    <!-- SubProcess Transit Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_SubTransit_ToHubScan" sourceRef="StartEvent_TransitLeg" targetRef="Task_HubInboundScan" />
    <bpmn:sequenceFlow id="Flow_SubTransit_ToManualScanFix" sourceRef="BoundaryError_ScannerFailure" targetRef="Task_ManualScanSupervisorUpdate" />
    <bpmn:sequenceFlow id="Flow_SubTransit_ToReconciliation" sourceRef="Task_ManualScanSupervisorUpdate" targetRef="Task_ReconcileBarcodeData" />
    <bpmn:sequenceFlow id="Flow_SubTransit_ReconciledToTransit" sourceRef="Task_ReconcileBarcodeData" targetRef="Task_HubInboundScan" />

    <bpmn:sequenceFlow id="Flow_SubTransit_ToCheckCustoms" sourceRef="Task_HubInboundScan" targetRef="Gateway_CustomsRequired" />
    <bpmn:sequenceFlow id="Flow_SubTransit_CustomsNeeded" name="International (E6)" sourceRef="Gateway_CustomsRequired" targetRef="Task_RequestCustomsDocuments">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isInternational == true &amp;&amp; customsCleared == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SubTransit_DomesticNoCustoms" name="Domestic / Cleared" sourceRef="Gateway_CustomsRequired" targetRef="Gateway_TransitDelayOrTimer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isInternational == false || customsCleared == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SubTransit_ToWaitForDocs" sourceRef="Task_RequestCustomsDocuments" targetRef="Task_UploadCustomsDocs" />
    <bpmn:sequenceFlow id="Flow_SubTransit_DocsProvided" sourceRef="Task_UploadCustomsDocs" targetRef="Gateway_TransitDelayOrTimer" />
    <bpmn:sequenceFlow id="Flow_SubTransit_CustomsLapsedReturn" sourceRef="BoundaryTimer_CustomsHold5Days" targetRef="EndEvent_ShipmentReturnedToSender" />

    <bpmn:sequenceFlow id="Flow_SubTransit_ToArrivalTimer" sourceRef="Gateway_TransitDelayOrTimer" targetRef="Event_TransitArrivalTimer" />
    <bpmn:sequenceFlow id="Flow_SubTransit_ToDelayMessage" sourceRef="Gateway_TransitDelayOrTimer" targetRef="Event_TransitDelayReceived" />
    <bpmn:sequenceFlow id="Flow_SubTransit_To48hScanTimer" sourceRef="Gateway_TransitDelayOrTimer" targetRef="Event_MissingScan48hTimer" />
    <bpmn:sequenceFlow id="Flow_SubTransit_ToHandleDelay" sourceRef="Event_TransitDelayReceived" targetRef="Task_NotifyCustomerDelayETA" />
    <bpmn:sequenceFlow id="Flow_SubTransit_ToRerouteVehicle" sourceRef="Task_NotifyCustomerDelayETA" targetRef="Task_RerouteTransitVehicle" />
    <bpmn:sequenceFlow id="Flow_SubTransit_ArrivedAtHub" sourceRef="Event_TransitArrivalTimer" targetRef="EndEvent_TransitLegComplete" />
    <bpmn:sequenceFlow id="Flow_SubTransit_ToTriggerTracingSubProcess" sourceRef="Event_MissingScan48hTimer" targetRef="SubProcess_TracingLostParcel" />

    <!-- E10 Cancellation Flows -->
    <bpmn:sequenceFlow id="Flow_ToCompensationCancellation" sourceRef="BoundaryMessage_ShipperCancellation" targetRef="Event_TriggerCompensationCancellation" />
    <bpmn:sequenceFlow id="Flow_CompensationToReturnSender" sourceRef="Event_TriggerCompensationCancellation" targetRef="EndEvent_ShipmentReturnedToSender" />

    <!-- Delivery Step Flows -->
    <bpmn:sequenceFlow id="Flow_ToDeliveryHandover" sourceRef="Task_NotifyRecipientOutForDelivery" targetRef="Task_DeliverParcelAndCapturePOD" />
    <bpmn:sequenceFlow id="Flow_ToDeliveryOutcomeGateway" sourceRef="Task_DeliverParcelAndCapturePOD" targetRef="Gateway_DeliveryOutcome" />
    <bpmn:sequenceFlow id="Flow_DeliveryAttemptSuccessful" name="Successful Delivery" sourceRef="Gateway_DeliveryOutcome" targetRef="Task_ReceiveParcelAndProvidePOD">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${deliveryOutcome == 'DELIVERED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToCloseShipment" sourceRef="Task_ReceiveParcelAndProvidePOD" targetRef="Task_CloseShipmentGenerateInvoice" />
    <bpmn:sequenceFlow id="Flow_ToDeliveredEndEvent" sourceRef="Task_CloseShipmentGenerateInvoice" targetRef="EndEvent_ShipmentDelivered" />

    <bpmn:sequenceFlow id="Flow_RecipientUnavailableE7" name="Unavailable (E7)" sourceRef="Gateway_DeliveryOutcome" targetRef="Gateway_DeliveryAttempts">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${deliveryOutcome == 'UNAVAILABLE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DeliveryAttemptRetry" name="Attempts &lt; 3" sourceRef="Gateway_DeliveryAttempts" targetRef="Task_NotifyRecipientOutForDelivery">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${deliveryAttempts &lt; 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_MaxDeliveryAttemptsExceeded" name="Attempts &gt;= 3" sourceRef="Gateway_DeliveryAttempts" targetRef="Task_DepotHold7Days">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${deliveryAttempts &gt;= 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DepotHoldExpiredReturnToSender" sourceRef="Task_DepotHold7Days" targetRef="EndEvent_ShipmentReturnedToSender" />

    <bpmn:sequenceFlow id="Flow_RefusalOrCODFailureE8" name="Refused / COD Failed (E8)" sourceRef="Gateway_DeliveryOutcome" targetRef="EndEvent_ShipmentReturnedToSender">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${deliveryOutcome == 'REFUSED' || deliveryOutcome == 'COD_FAILED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_DamagedParcelE3" name="Damaged (E3)" sourceRef="Gateway_DeliveryOutcome" targetRef="Task_InspectDamagedParcel">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${deliveryOutcome == 'DAMAGED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToInsuranceCheckGateway" sourceRef="Task_InspectDamagedParcel" targetRef="Gateway_InsuranceCheck" />
    <bpmn:sequenceFlow id="Flow_InsuredClaimsSubProcess" name="Insured = true" sourceRef="Gateway_InsuranceCheck" targetRef="SubProcess_ClaimsSettlement">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isInsured == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_UninsuredNotifyShipper" name="Insured = false" sourceRef="Gateway_InsuranceCheck" targetRef="EndEvent_ShipmentReturnedToSender">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isInsured == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ClaimsResolvedToRTS" sourceRef="SubProcess_ClaimsSettlement" targetRef="EndEvent_ShipmentReturnedToSender" />

    <bpmn:sequenceFlow id="Flow_WrongAddressDoorstepE2" name="Wrong Doorstep Address (E2)" sourceRef="Gateway_DeliveryOutcome" targetRef="Task_ContactRecipientDoorstep">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${deliveryOutcome == 'WRONG_ADDRESS'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToDoorstepSurchargeGateway" sourceRef="Task_ContactRecipientDoorstep" targetRef="Gateway_DoorstepAddressSurcharge" />
    <bpmn:sequenceFlow id="Flow_SurchargeAddedAndRetry" name="Surcharge Accepted" sourceRef="Gateway_DoorstepAddressSurcharge" targetRef="Gateway_DeliveryAttempts">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${surchargeAccepted == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AddressUnresolvableReturn" name="Unresolvable Address" sourceRef="Gateway_DoorstepAddressSurcharge" targetRef="EndEvent_ShipmentReturnedToSender">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${surchargeAccepted == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Lost Parcel Flows -->
    <bpmn:sequenceFlow id="Flow_LostParcelSubProcessComplete" sourceRef="SubProcess_TracingLostParcel" targetRef="EndEvent_LostParcelClosed" />
  </bpmn:process>

  <bpmn:error id="Error_PickupFailed" name="Error_PickupFailed" errorCode="ERR_PICKUP_FAILED" />
  <bpmn:error id="Error_ScannerOffline" name="Error_ScannerOffline" errorCode="ERR_SCANNER_OFFLINE" />
  <bpmn:message id="Message_TransitDelay" name="Message_TransitDelay" />
  <bpmn:message id="Message_ShipperCancellation" name="Message_ShipperCancellation" />

  <bpmndi:BPMNDiagram id="BPMNDiagram_Logistics">
    <bpmndi:BPMNPlane id="BPMNPlane_Logistics" bpmnElement="Collaboration_LogisticsShipment">
      <bpmndi:BPMNShape id="Participant_Courier_di" bpmnElement="Participant_Courier" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2400" height="1350" />
      </bpmndi:BPMNShape>

      <!-- 7 Lanes -->
      <bpmndi:BPMNShape id="Lane_Shipper_di" bpmnElement="Lane_Shipper" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2370" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ControlTower_di" bpmnElement="Lane_ControlTower" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="2370" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Pickup_di" bpmnElement="Lane_Pickup" isHorizontal="true">
        <dc:Bounds x="190" y="440" width="2370" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Hub_di" bpmnElement="Lane_Hub" isHorizontal="true">
        <dc:Bounds x="190" y="600" width="2370" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Delivery_di" bpmnElement="Lane_Delivery" isHorizontal="true">
        <dc:Bounds x="190" y="900" width="2370" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Recipient_di" bpmnElement="Lane_Recipient" isHorizontal="true">
        <dc:Bounds x="190" y="1080" width="2370" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Claims_di" bpmnElement="Lane_Claims" isHorizontal="true">
        <dc:Bounds x="190" y="1230" width="2370" height="200" />
      </bpmndi:BPMNShape>

      <!-- Nodes: Shipper Lane -->
      <bpmndi:BPMNShape id="StartEvent_BookingCreated_di" bpmnElement="StartEvent_BookingCreated">
        <dc:Bounds x="232" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="214" y="185" width="73" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateShipmentBooking_di" bpmnElement="Task_CreateShipmentBooking">
        <dc:Bounds x="320" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CorrectBookingAddress_di" bpmnElement="Task_CorrectBookingAddress">
        <dc:Bounds x="470" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_BookingCancelledFee_di" bpmnElement="EndEvent_BookingCancelledFee">
        <dc:Bounds x="832" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="810" y="185" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ShipmentReturnedToSender_di" bpmnElement="EndEvent_ShipmentReturnedToSender">
        <dc:Bounds x="2202" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2180" y="185" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Nodes: Control Tower Lane -->
      <bpmndi:BPMNShape id="Task_ValidateAddressAndTariff_di" bpmnElement="Task_ValidateAddressAndTariff">
        <dc:Bounds x="320" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AddressValidation_di" bpmnElement="Gateway_AddressValidation" isMarkerVisible="true">
        <dc:Bounds x="495" y="315" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AssignPickupDriver_di" bpmnElement="Task_AssignPickupDriver">
        <dc:Bounds x="610" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HandlePickupException_di" bpmnElement="Task_HandlePickupException">
        <dc:Bounds x="730" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PickupAttempts_di" bpmnElement="Gateway_PickupAttempts" isMarkerVisible="true">
        <dc:Bounds x="875" y="315" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Nodes: Pickup Agent Lane -->
      <bpmndi:BPMNShape id="Task_CollectAndScanParcel_di" bpmnElement="Task_CollectAndScanParcel">
        <dc:Bounds x="610" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryError_PickupFailed_di" bpmnElement="BoundaryError_PickupFailed">
        <dc:Bounds x="672" y="532" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Nodes: Hub Lane -->
      <bpmndi:BPMNShape id="Gateway_ParallelDispatchSplit_di" bpmnElement="Gateway_ParallelDispatchSplit">
        <dc:Bounds x="785" y="665" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_HubLineHaulTransit_di" bpmnElement="SubProcess_HubLineHaulTransit" isExpanded="true">
        <dc:Bounds x="900" y="630" width="600" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryMessage_ShipperCancellation_di" bpmnElement="BoundaryMessage_ShipperCancellation">
        <dc:Bounds x="1202" y="852" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_TriggerCompensationCancellation_di" bpmnElement="Event_TriggerCompensationCancellation">
        <dc:Bounds x="1202" y="732" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ParallelDispatchJoin_di" bpmnElement="Gateway_ParallelDispatchJoin">
        <dc:Bounds x="1565" y="665" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Nodes: Delivery Agent Lane -->
      <bpmndi:BPMNShape id="Task_NotifyRecipientOutForDelivery_di" bpmnElement="Task_NotifyRecipientOutForDelivery">
        <dc:Bounds x="1660" y="940" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DeliverParcelAndCapturePOD_di" bpmnElement="Task_DeliverParcelAndCapturePOD">
        <dc:Bounds x="1800" y="940" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DeliveryOutcome_di" bpmnElement="Gateway_DeliveryOutcome" isMarkerVisible="true">
        <dc:Bounds x="1955" y="955" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Nodes: Recipient Lane -->
      <bpmndi:BPMNShape id="Task_ReceiveParcelAndProvidePOD_di" bpmnElement="Task_ReceiveParcelAndProvidePOD">
        <dc:Bounds x="2060" y="1110" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Nodes: Claims Lane -->
      <bpmndi:BPMNShape id="Task_CloseShipmentGenerateInvoice_di" bpmnElement="Task_CloseShipmentGenerateInvoice">
        <dc:Bounds x="2060" y="1280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ShipmentDelivered_di" bpmnElement="EndEvent_ShipmentDelivered">
        <dc:Bounds x="2242" y="1302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2220" y="1345" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Connecting Lines -->
      <bpmndi:BPMNEdge id="Flow_ToCreateBooking_di" bpmnElement="Flow_ToCreateBooking">
        <di:waypoint x="268" y="160" />
        <di:waypoint x="320" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToValidateAddressAndTariff_di" bpmnElement="Flow_ToValidateAddressAndTariff">
        <di:waypoint x="370" y="200" />
        <di:waypoint x="370" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToAddressValidationGateway_di" bpmnElement="Flow_ToAddressValidationGateway">
        <di:waypoint x="420" y="340" />
        <di:waypoint x="495" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AddressValid_di" bpmnElement="Flow_AddressValid">
        <di:waypoint x="545" y="340" />
        <di:waypoint x="610" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToPickupCollection_di" bpmnElement="Flow_ToPickupCollection">
        <di:waypoint x="660" y="380" />
        <di:waypoint x="660" y="470" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToParallelSplit_di" bpmnElement="Flow_ToParallelSplit">
        <di:waypoint x="710" y="510" />
        <di:waypoint x="750" y="510" />
        <di:waypoint x="750" y="690" />
        <di:waypoint x="785" y="690" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ParallelToPhysicalTransit_di" bpmnElement="Flow_ParallelToPhysicalTransit">
        <di:waypoint x="835" y="690" />
        <di:waypoint x="900" y="690" />
