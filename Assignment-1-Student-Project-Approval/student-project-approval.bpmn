        <di:waypoint x="890" y="520" />
        <di:waypoint x="1000" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved">
        <di:waypoint x="1190" y="545" />
        <di:waypoint x="1190" y="750" />
        <di:waypoint x="1350" y="750" />
      </bpmndi:BPMNEdge>
